{
  "expo": {
    "name": "School Management",
    "slug": "schoolmanagementmobileapp",
    "icon": "./assets/images/icon.png",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "adaptiveIcon": {
              "backgroundColor": "#E6F4FE",
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundImage": "./assets/images/android-icon-background.png",
              "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "minSdkVersion": 28
          },
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "android": {
      "package": "com.nishanth_sekar.school_management_mobile_app2",
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.nishanthsekar.schoolmanagementmobileapp2",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "razorpay",
          "upi",
          "phonepe",
          "paytmmp",
          "gpay"
        ],
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload student images.",
        "NSCameraUsageDescription": "This app uses the camera to capture student photos."
      }
    },
    "runtimeVersion": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "c4165589-4248-4155-9ec0-8c6bc8c958fe"
      },
      "apiUrl": "https://schoolglobalserver-be.onrender.com",
      "razorpayKeyId": "rzp_live_Rt5vLcnxGaTs8Y"
    }
  }
}